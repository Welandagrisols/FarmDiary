{
  "expo": {
    "name": "Agrisols Farm Diary",
    "slug": "farm-diary",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "farmdiary",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.farmdiary"
    },
    "android": {
      "package": "com.farmdiary",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#1B5E20",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1B5E20"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Agrisols Farm Diary uses the camera to photograph soil test reports so their results can be read and saved.",
          "photosPermission": "Agrisols Farm Diary reads soil test report photos you choose from your gallery."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Agrisols Farm Diary uses your location while you walk around a plot to record its boundary."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "eda7ceee-0d43-4a6e-945e-37f315d2278c"
      }
    }
  }
}
